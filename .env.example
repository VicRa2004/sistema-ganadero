# Puerto donde se expondrá la aplicación unificada
PORT=3000

# Entorno ("prod" para servir la API y el Frontend en un solo puerto/dominio)
NODE_ENV=prod

# URL de conexión a la base de datos PostgreSQL (Externa / Host)
# Si PostgreSQL corre localmente en la máquina host, puedes usar host.docker.internal
DATABASE_URL="postgresql://usuario:password@host.docker.internal:5432/sistema_ganadero?schema=public"

# Clave secreta para firmar los JWT. Mínimo 32 caracteres; genera una con: openssl rand -base64 48
# En producción se rechazan los valores de ejemplo.
JWT_SECRET="CAMBIAR_genera_un_secreto_aleatorio_con_openssl_rand_base64_48"

# En producción, se deja "/api" o relativo porque la SPA se sirve desde el mismo host de la API
VITE_API_URL=/api

# Orígenes permitidos para CORS (separados por comas). Vacío = solo mismo origen (SPA servida por la API)
CORS_ORIGINS=

# Tamaño máximo por imagen subida, en bytes (5 MB por defecto)
UPLOAD_MAX_SIZE=5242880

# true detrás de Traefik/Dokploy para que el rate limit use la IP real (X-Forwarded-For)
TRUST_PROXY=true

# Tamaño máximo en bytes de las peticiones JSON (100 KB por defecto). Las subidas multipart usan UPLOAD_MAX_SIZE
BODY_MAX_SIZE=102400

# Swagger (/api-docs). Por defecto solo fuera de producción; "true" lo expone también en producción
ENABLE_API_DOCS=
