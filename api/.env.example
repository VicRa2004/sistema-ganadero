DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"
JWT_SECRET="supersecret_local_key_change_in_prod"
# Orígenes permitidos para CORS (separados por comas). Vacío = solo mismo origen.
CORS_ORIGINS=

# Tamaño máximo por imagen subida, en bytes (5 MB por defecto)
UPLOAD_MAX_SIZE=5242880

# Poner en true solo detrás de un proxy de confianza (Traefik/Dokploy) para leer X-Forwarded-For
TRUST_PROXY=false
