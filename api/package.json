		"pg": "8.23.1",
		"prisma": "7.10.1",
		"reflect-metadata": "0.2.2",
		"swagger-jsdoc": "6.3.0",
		"tsyringe": "4.10.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@types/bcrypt": "6.0.0",
		"@types/bun": "1.4.4",
		"@types/jsonwebtoken": "9.0.10",
		"@types/node": "25.5.2",
