generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
//  1. Entidades principales
// ─────────────────────────────────────────────

model User {
  id        Int       @id @default(autoincrement()) @map("usr_id")
  email     String    @unique @map("usr_email") @db.VarChar(128)
  name      String    @map("usr_nombre") @db.VarChar(255)
  password  String    @map("usr_password") @db.VarChar(255)
  isActive  Boolean   @default(true) @map("estatus")
  intentosFallidos Int       @default(0) @map("usr_intentos_fallidos")
  bloqueadoHasta   DateTime? @map("usr_bloqueado_hasta")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  // Relaciones N-a-N gestionadas por tablas intermedias explícitas
  roles             UserRole[]
  directPermissions UserPermission[]
  refreshTokens     RefreshToken[]
  terrenos          Terreno[]
  veterinarios      Veterinario[]
  insumos           Insumo[]
  propietarios      Propietario[]
  planesSanitarios  PlanSanitario[]
  notificaciones    Notificacion[]
  preferenciasNotificacion PreferenciaNotificacion[]
  transacciones     Transaccion[]
  gastos            Gasto[]
  movimientosInsumo MovimientoInsumo[]
  lotes             Lote[]
  racionesAlimentacion RacionAlimentacion[]
  suministrosRacion SuministroRacion[]

  @@map("user")
}

model Role {
  id          Int       @id @default(autoincrement()) @map("rol_id")
  name        String    @unique @map("rol_nombre") @db.VarChar(150) // e.g., 'ADMIN', 'MOD', 'USER'
  description String?   @map("rol_descripcion") @db.Text
  isActive    Boolean   @default(true) @map("estatus")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("rol")
}

/// Permiso atómico: combinación única de recurso + acción.
/// Ejemplo: resource="turnos", action="create"
model Permission {
  id        Int       @id @default(autoincrement()) @map("per_id")
  resource  String    @map("per_recurso") @db.VarChar(100) // e.g., "turnos", "users"
  action    String    @map("per_accion") @db.VarChar(50) // e.g., "create", "read", "update", "delete"
  isActive  Boolean   @default(true) @map("estatus")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  roles RolePermission[]
  users UserPermission[]

  @@unique([resource, action])
  @@map("permiso")
}

// ─────────────────────────────────────────────
//  2. Tablas intermedias (N-a-N explícitas)
// ─────────────────────────────────────────────

/// Asigna roles a usuarios
model UserRole {
  userId    Int      @map("usrrol_fkuser")
  roleId    Int      @map("usrrol_fkrol")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_rol")
}

/// Permisos que posee un rol completo
model RolePermission {
  roleId       Int @map("rolper_fkrol")
  permissionId Int @map("rolper_fkpermiso")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("rol_permiso")
}

/// Permisos directos o excepcionales por usuario (pueden conceder O denegar)
model UserPermission {
  userId       Int     @map("usrper_fkuser")
  permissionId Int     @map("usrper_fkpermiso")
  /// true = conceder, false = denegar (override sobre el rol)
  granted      Boolean @default(true) @map("usrper_concedido")

  user       User       @relation(fields: [userId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([userId, permissionId])
  @@map("user_permiso")
}

// ─────────────────────────────────────────────
//  3. Refresh Tokens
// ─────────────────────────────────────────────

/// Token de refresco para la rotación segura de sesiones.
/// Se almacena un hash del token, nunca el token en claro.
model RefreshToken {
  id        Int      @id @default(autoincrement()) @map("rft_id")
  tokenHash String   @unique @map("rft_token_hash") @db.VarChar(512)
  userId    Int      @map("rft_fkuser")
  expiresAt DateTime @map("rft_expires_at")
  revoked   Boolean  @default(false) @map("rft_revoked")
  createdAt DateTime @default(now()) @map("rft_created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_token")
}

// ─────────────────────────────────────────────
//  4. Enums de Negocio
// ─────────────────────────────────────────────

enum TipoInsumo {
  MEDICAMENTO
  VACUNA
  ALIMENTO
}

enum SexoGanado {
  MACHO
  HEMBRA
}

enum EstadoSesionSanitaria {
  PROGRAMADA
  REALIZADA
  CANCELADA
}

enum TipoNotificacion {
  STOCK_BAJO
  INSUMO_POR_CADUCAR
  TRATAMIENTO_POR_VENCER
  SESION_PROGRAMADA
  VACUNA_PENDIENTE
  PARTO_PROXIMO
  AUTONOMIA_ALIMENTO
}

enum TipoTransaccion {
  COMPRA
  VENTA
}

enum CategoriaGasto {
  ALIMENTO
  MEDICINA
  VETERINARIO
  MANO_OBRA
  MANTENIMIENTO
  OTRO
}

enum TipoMovimientoInsumo {
  ENTRADA
  SALIDA
  AJUSTE
}

enum PropositoLote {
  ENGORDA
  DESTETE
  VIENTRES
  RECRIA
  LECHE
  OTRO
}

enum TipoEventoReproductivo {
  MONTA
  INSEMINACION
  DIAGNOSTICO_GESTACION
  PARTO
  DESTETE
  ABORTO
}

enum ResultadoDiagnostico {
  POSITIVO
  NEGATIVO
}

// ─────────────────────────────────────────────
//  5. Tablas de Negocio
// ─────────────────────────────────────────────

model Raza {
  id          Int       @id @default(autoincrement()) @map("raz_id")
  nombre      String    @map("raz_nombre") @db.VarChar(100) // único entre activos: índice parcial en SQL
  descripcion String?   @map("raz_descripcion") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  ganados          Ganado[]
  planesSanitarios PlanSanitario[]

  @@map("raza")
}

model Propietario {
  id          Int       @id @default(autoincrement()) @map("prop_id")
  nombre      String    @map("prop_nombre") @db.VarChar(255)
  telefono    String?   @map("prop_telefono") @db.VarChar(20)
  correo      String?   @map("prop_correo") @db.VarChar(128)
  imagenMarca String?   @map("prop_imagen_marca") @db.VarChar(255)
  usuarioId   Int       @map("prop_fkusuario")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  usuario User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  ganados Ganado[]

  @@index([usuarioId])
  @@map("propietario")
}

model Terreno {
  id                 Int       @id @default(autoincrement()) @map("terr_id")
  nombre             String    @map("terr_nombre") @db.VarChar(150)
  ubicacion          String    @map("terr_ubicacion") @db.VarChar(255)
  extensionHectareas Float     @map("terr_extension")
  capacidadMaxima    Int       @map("terr_capacidad_max")
  imagenTerreno      String?   @map("terr_imagen") @db.VarChar(255)
  usuarioId          Int       @map("terr_fkusuario")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime? @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  usuario            User            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  ganados            Ganado[]
  planesSanitarios   PlanSanitario[]
  gastos             Gasto[]
  lotes              Lote[]
  racionesAlimentacion RacionAlimentacion[]
  suministrosRacion  SuministroRacion[]
  movimientosInsumo  MovimientoInsumo[]
  trasladosOrigen    HistorialTraslado[] @relation("Traslado_Origen")
  trasladosDestino   HistorialTraslado[] @relation("Traslado_Destino")

  @@index([usuarioId])
  @@map("terreno")
}

model MotivoBaja {
  id          Int       @id @default(autoincrement()) @map("mtb_id")
  nombre      String    @unique @map("mtb_nombre") @db.VarChar(100)
  descripcion String?   @map("mtb_descripcion") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")

  ganados Ganado[]

  @@map("motivo_baja")
}

model Ganado {
  id              Int        @id @default(autoincrement()) @map("gan_id")
  identificador   String     @map("gan_identificador") @db.VarChar(50) // único entre activos: índice parcial en SQL
  peso            Float      @map("gan_peso")
  fechaNacimiento DateTime   @map("gan_fecha_nacimiento") @db.Date
  sexo            SexoGanado @map("gan_sexo")
  imagenGanado    String?    @map("gan_imagen") @db.VarChar(255)
  razaId          Int        @map("gan_fkraza")
  terrenoId       Int        @map("gan_fkterreno")
  propietarioId   Int        @map("gan_fkpropietario")
  padreId         Int?       @map("gan_fkpadre")
  madreId         Int?       @map("gan_fkmadre")
  partoEventoId   Int?       @map("gan_fkparto_evento")
  fechaBaja       DateTime?  @map("gan_fecha_baja")
  motivoBajaId    Int?       @map("gan_fkmotivo_baja")
  procedencia     String?    @map("gan_procedencia") @db.VarChar(200)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime?  @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  raza                   Raza                  @relation(fields: [razaId], references: [id], onDelete: Restrict)
  terreno                Terreno               @relation(fields: [terrenoId], references: [id], onDelete: Restrict)
  propietario            Propietario           @relation(fields: [propietarioId], references: [id], onDelete: Restrict)
  padre                  Ganado?               @relation("Linaje_Padre", fields: [padreId], references: [id], onDelete: Restrict)
  madre                  Ganado?               @relation("Linaje_Madre", fields: [madreId], references: [id], onDelete: Restrict)
  hijosComoPadre         Ganado[]              @relation("Linaje_Padre")
  hijosComoMadre         Ganado[]              @relation("Linaje_Madre")
  eventoParto            EventoReproductivo?   @relation("PartoCrias", fields: [partoEventoId], references: [id], onDelete: SetNull)
  eventosComoHembra      EventoReproductivo[]  @relation("Reproduccion_Hembra")
  eventosComoMacho       EventoReproductivo[]  @relation("Reproduccion_Macho")
  motivoBaja             MotivoBaja?           @relation(fields: [motivoBajaId], references: [id], onDelete: Restrict)
  aplicacionesSanitarias AplicacionSanitaria[]
  tratamientosMedicos    TratamientoMedico[]
  pesajes                Pesaje[]
  transacciones          TransaccionGanado[]
  gastos                 Gasto[]
  lotes                  LoteGanado[]
  movimientosInsumo      MovimientoInsumo[]
  traslados              HistorialTraslado[]

  @@index([terrenoId])
  @@index([razaId])
  @@index([propietarioId])
  @@index([fechaBaja])
  @@index([deletedAt])
  @@map("ganado")
}

model Pesaje {
  id            Int      @id @default(autoincrement()) @map("pes_id")
  ganadoId      Int      @map("pes_fkganado")
  peso          Float    @map("pes_peso")
  fecha         DateTime @map("pes_fecha")
  observaciones String?  @map("pes_observaciones") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  ganado Ganado @relation(fields: [ganadoId], references: [id], onDelete: Cascade)

  @@index([ganadoId, fecha])
  @@map("pesaje")
}

/// Lo rellena el trigger `registrar_traslado_ganado` al cambiar `ganado.gan_fkterreno`,
/// así cubre cualquier vía de traslado (individual, masivo por lote, edición).
model HistorialTraslado {
  id               Int      @id @default(autoincrement()) @map("tra_id")
  ganadoId         Int      @map("tra_fkganado")
  terrenoOrigenId  Int      @map("tra_fkterreno_origen")
  terrenoDestinoId Int      @map("tra_fkterreno_destino")
  fecha            DateTime @default(now()) @map("tra_fecha")

  ganado         Ganado  @relation(fields: [ganadoId], references: [id], onDelete: Cascade)
  terrenoOrigen  Terreno @relation("Traslado_Origen", fields: [terrenoOrigenId], references: [id], onDelete: Cascade)
  terrenoDestino Terreno @relation("Traslado_Destino", fields: [terrenoDestinoId], references: [id], onDelete: Cascade)

  @@index([ganadoId, fecha])
  @@map("historial_traslado")
}

model Insumo {
  id                Int        @id @default(autoincrement()) @map("ins_id")
  nombre            String     @map("ins_nombre") @db.VarChar(150)
  tipo              TipoInsumo @map("ins_tipo")
  stock             Decimal    @map("ins_stock") @db.Decimal(12, 3)
  stockMinimo       Decimal    @map("ins_stock_minimo") @db.Decimal(12, 3)
  unidadMedida      String     @map("ins_unidad") @db.VarChar(20)
  lote              String     @map("ins_lote") @db.VarChar(50)
  fechaCaducidad    DateTime   @map("ins_fecha_caducidad")
  periodoRetiroDias Int        @default(0) @map("ins_periodo_retiro_dias")
  costoUnitario     Decimal    @default(0) @map("ins_costo_unitario") @db.Decimal(12, 2)
  usuarioId         Int        @map("ins_fkusuario")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime?  @updatedAt @map("updated_at")
  deletedAt         DateTime?  @map("deleted_at")

  usuario             User                 @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  sesionesSanitarias  SesionSanitaria[]
  tratamientosMedicos TratamientoMedico[]
  planesSanitarios    PlanSanitario[]
  movimientos         MovimientoInsumo[]
  raciones            RacionAlimentacion[]
  suministros         SuministroRacion[]

  @@index([usuarioId])
  @@index([tipo])
  @@index([deletedAt])
  @@map("insumo")
}

model SesionSanitaria {
  id              Int                   @id @default(autoincrement()) @map("ses_id")
  fecha           DateTime              @map("ses_fecha")
  veterinarioId   Int                   @map("ses_fkveterinario")
  descripcion     String                @map("ses_descripcion") @db.Text
  insumoId        Int                   @map("ses_fkinsumo")
  estado          EstadoSesionSanitaria @default(REALIZADA) @map("ses_estado")
  planSanitarioId Int?                  @map("ses_fkplan_sanitario")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime?             @updatedAt @map("updated_at")
  deletedAt       DateTime?             @map("deleted_at")

  insumo        Insumo                @relation(fields: [insumoId], references: [id], onDelete: Restrict)
  veterinario   Veterinario           @relation(fields: [veterinarioId], references: [id], onDelete: Restrict)
  planSanitario PlanSanitario?        @relation(fields: [planSanitarioId], references: [id], onDelete: SetNull)
  aplicaciones  AplicacionSanitaria[]

  @@index([fecha])
  @@index([veterinarioId])
  @@index([insumoId])
  @@index([estado])
  @@index([planSanitarioId])
  @@map("sesion_sanitaria")
}

model AplicacionSanitaria {
  id            Int       @id @default(autoincrement()) @map("aps_id")
  sesionId      Int       @map("aps_fksesion")
  ganadoId      Int       @map("aps_fkganado")
  dosisAplicada Decimal   @map("aps_dosis") @db.Decimal(12, 3)
  observaciones String?   @map("aps_observaciones") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  deletedAt     DateTime? @map("deleted_at")

  sesion SesionSanitaria @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  ganado Ganado          @relation(fields: [ganadoId], references: [id], onDelete: Restrict)

  @@unique([sesionId, ganadoId])
  @@map("aplicacion_sanitaria")
}

model TratamientoMedico {
  id            Int       @id @default(autoincrement()) @map("trt_id")
  ganadoId      Int       @map("trt_fkganado")
  diagnostico   String    @map("trt_diagnostico") @db.VarChar(255)
  fechaInicio   DateTime  @map("trt_fecha_inicio")
  fechaFin      DateTime  @map("trt_fecha_fin")
  activo        Boolean   @default(true) @map("trt_activo")
  insumoId      Int       @map("trt_fkinsumo")
  dosisDiaria   Decimal   @map("trt_dosis_diaria") @db.Decimal(12, 3)
  veterinarioId Int?      @map("trt_fkveterinario")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime? @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  ganado      Ganado       @relation(fields: [ganadoId], references: [id], onDelete: Restrict)
  insumo      Insumo       @relation(fields: [insumoId], references: [id], onDelete: Restrict)
  veterinario Veterinario? @relation(fields: [veterinarioId], references: [id], onDelete: Restrict)

  @@index([ganadoId])
  @@index([activo])
  @@index([fechaFin])
  @@map("tratamiento_medico")
}

model EventoReproductivo {
  id                 Int                    @id @default(autoincrement()) @map("evr_id")
  hembraId           Int                    @map("evr_fkhembra")
  machoId            Int?                   @map("evr_fkmacho")
  tipo               TipoEventoReproductivo @map("evr_tipo")
  fecha              DateTime               @map("evr_fecha")
  resultado          ResultadoDiagnostico?  @map("evr_resultado")
  fechaProbableParto DateTime?              @map("evr_fecha_probable_parto")
  observaciones      String?                @map("evr_observaciones") @db.Text
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime?              @updatedAt @map("updated_at")
  deletedAt          DateTime?              @map("deleted_at")

  hembra Ganado   @relation("Reproduccion_Hembra", fields: [hembraId], references: [id], onDelete: Restrict)
  macho  Ganado?  @relation("Reproduccion_Macho", fields: [machoId], references: [id], onDelete: Restrict)
  crias  Ganado[] @relation("PartoCrias")

  @@index([hembraId, fecha])
  @@index([machoId])
  @@index([tipo])
  @@index([fechaProbableParto])
  @@index([deletedAt])
  @@map("evento_reproductivo")
}

model Veterinario {
  id                Int       @id @default(autoincrement()) @map("vet_id")
  nombre            String    @map("vet_nombre") @db.VarChar(255)
  telefono          String    @map("vet_telefono") @db.VarChar(20)
  cedulaProfesional String    @map("vet_cedula") @db.VarChar(50) // único entre activos: índice parcial en SQL
  especialidad      String?   @map("vet_especialidad") @db.VarChar(100)
  usuarioId         Int       @map("vet_fkusuario")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime? @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  usuario             User                @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  sesionesSanitarias  SesionSanitaria[]
  tratamientosMedicos TratamientoMedico[]
  planesSanitarios    PlanSanitario[]

  @@index([usuarioId])
  @@map("veterinario")
}

// ─────────────────────────────────────────────
//  6. Planes Sanitarios, Notificaciones y Outbox
// ─────────────────────────────────────────────

model PlanSanitario {
  id               Int       @id @default(autoincrement()) @map("pln_id")
  nombre           String    @map("pln_nombre") @db.VarChar(150)
  descripcion      String    @map("pln_descripcion") @db.Text
  frecuenciaDias   Int       @map("pln_frecuencia_dias")
  dosisPorAnimal   Decimal   @map("pln_dosis_animal") @db.Decimal(12, 3)
  veterinarioId    Int       @map("pln_fkveterinario")
  insumoId         Int       @map("pln_fkinsumo")
  terrenoId        Int?      @map("pln_fkterreno")
  razaId           Int?      @map("pln_fkraza")
  edadMinimaMeses  Int?      @map("pln_edad_minima_meses")
  proximaEjecucion DateTime  @map("pln_proxima_ejecucion")
  activo           Boolean   @default(true) @map("pln_activo")
  usuarioId        Int       @map("pln_fkusuario")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime? @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  usuario     User              @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  veterinario Veterinario       @relation(fields: [veterinarioId], references: [id], onDelete: Restrict)
  insumo      Insumo            @relation(fields: [insumoId], references: [id], onDelete: Restrict)
  terreno     Terreno?          @relation(fields: [terrenoId], references: [id], onDelete: SetNull)
  raza        Raza?             @relation(fields: [razaId], references: [id], onDelete: SetNull)
  sesiones    SesionSanitaria[]

  @@index([usuarioId])
  @@index([activo, proximaEjecucion])
  @@map("plan_sanitario")
}

model Notificacion {
  id                 Int              @id @default(autoincrement()) @map("not_id")
  usuarioId          Int              @map("not_fkusuario")
  tipo               TipoNotificacion @map("not_tipo")
  titulo             String           @map("not_titulo") @db.VarChar(200)
  cuerpo             String           @map("not_cuerpo") @db.Text
  referenciaTipo     String?          @map("not_ref_tipo") @db.VarChar(50)
  referenciaId       Int?             @map("not_ref_id")
  claveDeduplicacion String           @map("not_clave_dedup") @db.VarChar(160)
  leidaAt            DateTime?        @map("not_leida_at")
  createdAt          DateTime         @default(now()) @map("created_at")

  usuario User @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, claveDeduplicacion])
  @@index([usuarioId, leidaAt])
  @@index([createdAt])
  @@map("notificacion")
}

model PreferenciaNotificacion {
  id        Int              @id @default(autoincrement()) @map("prf_id")
  usuarioId Int              @map("prf_fkusuario")
  tipo      TipoNotificacion @map("prf_tipo")
  inApp     Boolean          @default(true) @map("prf_in_app")
  email     Boolean          @default(false) @map("prf_email")
  updatedAt DateTime?        @updatedAt @map("updated_at")

  usuario User @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, tipo])
  @@map("preferencia_notificacion")
}

model EventoOutbox {
  id          Int       @id @default(autoincrement()) @map("out_id")
  eventName   String    @map("out_event_name") @db.VarChar(120)
  payload     Json      @map("out_payload")
  procesadoAt DateTime? @map("out_procesado_at")
  error       String?   @map("out_error") @db.Text
  intentos    Int       @default(0) @map("out_intentos")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([procesadoAt])
  @@map("evento_outbox")
}

// ─────────────────────────────────────────────
//  7. Comercial, Costos, Kardex, Lotes y Alimentación
// ─────────────────────────────────────────────

model Transaccion {
  id               Int             @id @default(autoincrement()) @map("trn_id")
  tipo             TipoTransaccion @map("trn_tipo")
  fecha            DateTime        @map("trn_fecha")
  contraparte      String          @map("trn_contraparte") @db.VarChar(200)
  total            Decimal         @map("trn_total") @db.Decimal(14, 2)
  moneda           String          @default("MXN") @map("trn_moneda") @db.VarChar(10)
  documento        String?         @map("trn_documento") @db.VarChar(150)
  documentoAdjunto String?         @map("trn_documento_adjunto") @db.VarChar(255)
  observaciones    String?         @map("trn_observaciones") @db.Text
  usuarioId        Int             @map("trn_fkusuario")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime?       @updatedAt @map("updated_at")
  deletedAt        DateTime?       @map("deleted_at")

  usuario  User                @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  detalles TransaccionGanado[]

  @@index([usuarioId, fecha])
  @@index([tipo])
  @@index([deletedAt])
  @@map("transaccion")
}

model TransaccionGanado {
  id            Int     @id @default(autoincrement()) @map("trg_id")
  transaccionId Int     @map("trg_fktransaccion")
  ganadoId      Int     @map("trg_fkganado")
  precio        Decimal @map("trg_precio") @db.Decimal(14, 2)
  pesoRegistro  Float   @map("trg_peso_registro")
  procedencia   String? @map("trg_procedencia") @db.VarChar(200)

  transaccion Transaccion @relation(fields: [transaccionId], references: [id], onDelete: Cascade)
  ganado      Ganado      @relation(fields: [ganadoId], references: [id], onDelete: Restrict)

  @@unique([transaccionId, ganadoId])
  @@index([ganadoId])
  @@map("transaccion_ganado")
}

model Gasto {
  id            Int            @id @default(autoincrement()) @map("gas_id")
  categoria     CategoriaGasto @map("gas_categoria")
  concepto      String         @map("gas_concepto") @db.VarChar(200)
  monto         Decimal        @map("gas_monto") @db.Decimal(14, 2)
  fecha         DateTime       @map("gas_fecha")
  terrenoId     Int?           @map("gas_fkterreno")
  ganadoId      Int?           @map("gas_fkganado")
  loteId        Int?           @map("gas_fklote")
  observaciones String?        @map("gas_observaciones") @db.Text
  usuarioId     Int            @map("gas_fkusuario")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime?      @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")

  usuario User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  terreno Terreno? @relation(fields: [terrenoId], references: [id], onDelete: SetNull)
  ganado  Ganado?  @relation(fields: [ganadoId], references: [id], onDelete: Restrict)
  lote    Lote?    @relation(fields: [loteId], references: [id], onDelete: SetNull)

  @@index([usuarioId, fecha])
  @@index([categoria])
  @@index([terrenoId])
  @@index([ganadoId])
  @@index([loteId])
  @@index([deletedAt])
  @@map("gasto")
}

model MovimientoInsumo {
  id             Int                  @id @default(autoincrement()) @map("mov_id")
  insumoId       Int                  @map("mov_fkinsumo")
  tipo           TipoMovimientoInsumo @map("mov_tipo")
  cantidad       Decimal              @map("mov_cantidad") @db.Decimal(12, 3)
  delta          Decimal              @map("mov_delta") @db.Decimal(12, 3)
  costoUnitario  Decimal?             @map("mov_costo_unitario") @db.Decimal(12, 2)
  motivo         String               @map("mov_motivo") @db.VarChar(255)
  referenciaTipo String?              @map("mov_ref_tipo") @db.VarChar(50)
  referenciaId   Int?                 @map("mov_ref_id")
  ganadoId       Int?                 @map("mov_fkganado")
  terrenoId      Int?                 @map("mov_fkterreno")
  loteId         Int?                 @map("mov_fklote")
  usuarioId      Int                  @map("mov_fkusuario")
  fecha          DateTime             @default(now()) @map("mov_fecha")
  createdAt      DateTime             @default(now()) @map("created_at")

  insumo  Insumo   @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  ganado  Ganado?  @relation(fields: [ganadoId], references: [id], onDelete: SetNull)
  terreno Terreno? @relation(fields: [terrenoId], references: [id], onDelete: SetNull)
  lote    Lote?    @relation(fields: [loteId], references: [id], onDelete: SetNull)
  usuario User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([insumoId, fecha])
  @@index([ganadoId])
  @@index([terrenoId])
  @@index([loteId])
  @@index([referenciaTipo, referenciaId])
  @@map("movimiento_insumo")
}

model Lote {
  id          Int           @id @default(autoincrement()) @map("lot_id")
  nombre      String        @map("lot_nombre") @db.VarChar(150)
  proposito   PropositoLote @default(ENGORDA) @map("lot_proposito")
  descripcion String?       @map("lot_descripcion") @db.Text
  terrenoId   Int?          @map("lot_fkterreno")
  activo      Boolean       @default(true) @map("lot_activo")
  usuarioId   Int           @map("lot_fkusuario")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime?     @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  usuario           User                 @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  terreno           Terreno?             @relation(fields: [terrenoId], references: [id], onDelete: SetNull)
  miembros          LoteGanado[]
  gastos            Gasto[]
  raciones          RacionAlimentacion[]
  suministros       SuministroRacion[]
  movimientosInsumo MovimientoInsumo[]

  @@index([usuarioId])
  @@index([terrenoId])
  @@index([proposito])
  @@index([deletedAt])
  @@map("lote")
}

model LoteGanado {
  loteId       Int      @map("lgn_fklote")
  ganadoId     Int      @map("lgn_fkganado")
  fechaIngreso DateTime @default(now()) @map("lgn_fecha_ingreso")

  lote   Lote   @relation(fields: [loteId], references: [id], onDelete: Cascade)
  ganado Ganado @relation(fields: [ganadoId], references: [id], onDelete: Cascade)

  @@id([loteId, ganadoId])
  @@index([ganadoId])
  @@map("lote_ganado")
}

model RacionAlimentacion {
  id                      Int       @id @default(autoincrement()) @map("rac_id")
  nombre                  String    @map("rac_nombre") @db.VarChar(150)
  insumoId                Int       @map("rac_fkinsumo")
  terrenoId               Int?      @map("rac_fkterreno")
  loteId                  Int?      @map("rac_fklote")
  cantidadDiariaPorAnimal Decimal   @map("rac_cantidad_diaria_animal") @db.Decimal(12, 3)
  diasAlertaAutonomia     Int       @default(7) @map("rac_dias_alerta_autonomia")
  activo                  Boolean   @default(true) @map("rac_activo")
  observaciones           String?   @map("rac_observaciones") @db.Text
  usuarioId               Int       @map("rac_fkusuario")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime? @updatedAt @map("updated_at")
  deletedAt               DateTime? @map("deleted_at")

  usuario     User               @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  insumo      Insumo             @relation(fields: [insumoId], references: [id], onDelete: Restrict)
  terreno     Terreno?           @relation(fields: [terrenoId], references: [id], onDelete: SetNull)
  lote        Lote?              @relation(fields: [loteId], references: [id], onDelete: SetNull)
  suministros SuministroRacion[]

  @@index([usuarioId])
  @@index([insumoId])
  @@index([terrenoId])
  @@index([loteId])
  @@index([activo])
  @@index([deletedAt])
  @@map("racion_alimentacion")
}

model SuministroRacion {
  id               Int      @id @default(autoincrement()) @map("sum_id")
  racionId         Int      @map("sum_fkracion")
  insumoId         Int      @map("sum_fkinsumo")
  terrenoId        Int?     @map("sum_fkterreno")
  loteId           Int?     @map("sum_fklote")
  fecha            DateTime @map("sum_fecha")
  cantidadAnimales Int      @map("sum_cantidad_animales")
  cantidadTotal    Decimal  @map("sum_cantidad_total") @db.Decimal(12, 3)
  costoTotal       Decimal  @map("sum_costo_total") @db.Decimal(14, 2)
  observaciones    String?  @map("sum_observaciones") @db.Text
  usuarioId        Int      @map("sum_fkusuario")
  createdAt        DateTime @default(now()) @map("created_at")

  racion  RacionAlimentacion @relation(fields: [racionId], references: [id], onDelete: Restrict)
  insumo  Insumo             @relation(fields: [insumoId], references: [id], onDelete: Restrict)
  terreno Terreno?           @relation(fields: [terrenoId], references: [id], onDelete: SetNull)
  lote    Lote?              @relation(fields: [loteId], references: [id], onDelete: SetNull)
  usuario User               @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([racionId, fecha])
  @@index([insumoId])
  @@index([terrenoId])
  @@index([loteId])
  @@index([usuarioId])
  @@map("suministro_racion")
}
