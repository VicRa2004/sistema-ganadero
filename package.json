{
	"name": "sistema-ganadero-monorepo",
	"private": true,
	"scripts": {
		"prepare": "lefthook install || true",
		"dev": "pnpm --filter api dev & pnpm --filter web dev",
		"dev:api": "pnpm --filter api dev",
		"dev:web": "pnpm --filter web dev",
		"build:api": "pnpm --filter api build",
		"build:web": "pnpm --filter web build",
		"typecheck:api": "pnpm --filter api typecheck",
		"typecheck:web": "pnpm --filter web exec tsc -b",
		"typecheck": "pnpm typecheck:api && pnpm typecheck:web",
		"test:api": "pnpm --filter api test",
		"test:coverage": "pnpm --filter api test:coverage",
		"lint": "biome lint .",
		"format:check": "biome format .",
		"format": "biome format --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.12",
		"lefthook": "2.2.2"
	}
}
